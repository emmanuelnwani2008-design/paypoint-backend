# PayPoint Backend — Environment Variables
# Copy this to `.env` and fill in the values before running.

# ---------- Supabase (required) ----------
# Get these from https://supabase.com → your project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- Paystack (only needed if you enable Pro subscriptions) ----------
# Get from https://dashboard.paystack.com → Settings → API Keys
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxx

# ---------- Public URLs (no trailing slash) ----------
FRONTEND_URL=https://your-frontend.netlify.app
BACKEND_URL=https://your-backend.onrender.com

# ---------- CORS (comma-separated) ----------
ALLOWED_ORIGINS=https://your-frontend.netlify.app,http://localhost:3000

# ---------- Server ----------
PORT=3000
NODE_ENV=production